### 3️⃣ 代码级设计

\`\`\`rust
// === content_processor.rs ===

/// 内容类型枚举
pub enum ContentType {
    Html(String),     // 原始HTML
    Markdown(String), // Markdown文档
    Text(String),     // 纯文本
    Code(String),     // 代码
}

/// 预处理配置
pub struct ProcessConfig {
    pub max_tokens: usize,        // 输出token上限（默认4000）
    pub extract_tables: bool,     // 是否提取表格
    pub extract_lists: bool,      // 是否提取列表
    pub keep_headings: bool,      // 是否保留标题层级
    pub remove_code_blocks: bool, // 是否移除代码块
}

/// 预处理结果
pub struct ProcessedContent {
    pub original_size: usize,
    pub processed_size: usize,
    pub token_saved_pct: f64,     // 如 "节省了 72%"
    pub content: String,          // 处理后的内容
    pub metadata: HashMap<String, Value>,
}

/// 内容预处理管道
pub struct ContentProcessor {
    config: ProcessConfig,
}

impl ContentProcessor {
    /// 处理入口：自动识别类型并执行全管道
    pub fn process(&self, input: ContentType) -> ProcessedContent {
        let original_size = input.raw_size();

        // Level 1: 去噪
        let cleaned = self.remove_noise(input);

        // Level 2: 结构化提取
        let structured = self.extract_structure(cleaned);

        // Level 3: Token优化
        let optimized = self.optimize_tokens(structured);

        ProcessedContent {
            original_size,
            processed_size: optimized.len(),
            token_saved_pct: calc_savings(original_size, optimized.len()),
            content: optimized,
            metadata: self.extract_metadata(structured),
        }
    }

    /// Level 1: 去噪 — 参考Scrapling的"关键区域提取"
    fn remove_noise(&self, input: ContentType) -> String {
        match input {
            ContentType::Html(html) => {
                // 移除: <script>, <style>, <nav>, <footer>, <aside>, 
                //       广告类div, 跟踪代码等
                // Rust可用: scraper crate (CSS选择器) 或 tl crate (HTML解析)
                remove_noise_html(&html, &self.config)
            }
            ContentType::Markdown(md) => {
                // 移除: 图片链接、过长的代码块、重复的引用
                clean_markdown(&md)
            }
            ContentType::Text(t) => t,
            ContentType::Code(c) => c,
        }
    }

    /// Level 2: 结构化提取 — 关键创新点
    fn extract_structure(&self, cleaned: String) -> Vec<ContentBlock> {
        let mut blocks = Vec::new();

        // 按标题/段落分割成语义块
        for section in split_by_headings(&cleaned) {
            blocks.push(ContentBlock {
                level: section.level,         // h1/h2/h3等
                title: section.title,
                summary: summarize(section.body, 100), // 每段先摘要
                importance: score_importance(&section),
                tokens: estimate_tokens(&section.body),
            });
        }

        // 按重要性排序（重要内容排前面）
        blocks.sort_by(|a, b| b.importance.cmp(&a.importance));
        blocks
    }

    /// Level 3: Token优化 — Scrapling省70% token的核心
    fn optimize_tokens(&self, blocks: Vec<ContentBlock>) -> String {
        let mut output = String::new();
        let mut used_tokens = 0;
        let max = self.config.max_tokens;

        for block in blocks {
            if used_tokens + block.tokens > max {
                // 超出预算：只保留标题和摘要
                output.push_str(&format!("## {}\\n> {}\\n\\n", 
                    block.title, block.summary));
                used_tokens += estimate_tokens(&block.summary) + 10;
            } else {
                output.push_str(&block.full_text());
                used_tokens += block.tokens;
            }

            if used_tokens >= max { break; }
        }

        output
    }
}
