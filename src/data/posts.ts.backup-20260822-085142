// 统一工具返回的"大小控制"
fn truncate_response(text: &str, max_chars: usize) -> String {
    if text.len() > max_chars {
        let truncated = &text[..max_chars];
        format!("{}...\\n\\n[⚠️ 内容过长已截断，原长度: {}, 已截取前{}字符]", 
            truncated, text.len(), max_chars)
    } else {
        text.to_string()
    }
}

// 在 execute_code_analyze 等方法中直接套用
